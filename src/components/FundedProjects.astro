          <div class="project-meta">
            <span>{project.period}</span>
            <span>{project.sponsor}</span>
          </div>

          <h4>{project.title}</h4>
        </article>
      ))}
    </div>
  </div>

  <div class="research-group">
    <h3>
      Co-Investigator
