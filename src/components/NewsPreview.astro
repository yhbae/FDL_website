---
import { news } from "../data/news";

const latestNews = news.slice(0, 3);
---

<section class="news-preview">
  <div class="news-header">
    <div>
      <p class="section-label">NEWS</p>
      <h2>Latest News</h2>
    </div>

    <a href="/news" class="view-all">View all news →</a>
  </div>

  <div class="news-list">
    {latestNews.map((item) => (
      <a href={`/news/${item.slug}`} class="news-item">
        {item.image && (
          <img
            src={item.image}
            alt={item.title}
            class="news-image"
          />
        )}

        <div class="news-date">{item.date}</div>

        <div>
          <p class="news-category">{item.category}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .news-preview {
    padding: 100px 8%;
    background: #f8fafc;
  }

  .news-header {
    max-width: 1180px;
    margin: 0 auto 42px;

    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .section-label {
    margin: 0 0 16px;
    color: #0369a1;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.03em;
  }

  .view-all {
    color: #0369a1;
    font-weight: 700;
    text-decoration: none;
  }

  .news-list {
    max-width: 1180px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .news-item {
    display: block;

    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 22px;
    min-height: 320px;

    color: inherit;
    text-decoration: none;

    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .news-item:hover {
    transform: translateY(-5px);
    border-color: rgba(3, 105, 161, 0.22);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06);
  }

  .news-image {
    width: 100%;
    height: 145px;
    object-fit: cover;
    border-radius: 18px;
    margin-bottom: 22px;
    background: #e2e8f0;
  }

  .news-date {
    color: #0369a1;
    font-weight: 800;
    margin-bottom: 18px;
  }

  .news-category {
    margin: 0 0 10px;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .news-item h3 {
    margin: 0 0 14px;
    font-size: 22px;
    line-height: 1.35;
  }

  .news-item p {
    color: #475569;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .news-header {
      align-items: start;
      flex-direction: column;
    }

    .news-list {
      grid-template-columns: 1fr;
    }

    .news-image {
      height: 220px;
    }
  }
</style>