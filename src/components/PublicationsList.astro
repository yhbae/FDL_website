<section class="publications">
  <div class="pub-group">
    <h2>Refereed Journals</h2>

    <div class="pub-list">
      {journals.map((pub) => (
        <article class="pub-item">
          <div class="year">{pub.year}</div>
          <p>{pub.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="pub-group">
    <h2>International Conference Proceedings</h2>

    <div class="pub-list">
      {conferences.map((pub) => (
        <article class="pub-item">
          <div class="year">{pub.year}</div>
          <p>{pub.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .publications {
    display: flex;
    flex-direction: column;
    gap: 90px;
  }

  .pub-group h2 {
    font-size: clamp(34px, 5vw, 56px);
    letter-spacing: -0.05em;
    margin: 0 0 36px;
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pub-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 28px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    padding: 26px 30px;
  }

  .year {
    color: #0f766e;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .pub-item p {
    margin: 0;
    color: #334155;
    line-height: 1.8;
  }

  @media (max-width: 760px) {
    .pub-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>