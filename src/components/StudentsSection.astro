---
const phdStudents = [
  {
    name: "Yeonbin Lee",
    interests: [
      "Floater hydrodynamics",
      "Wave energy converters based on Machine Learning",
      "Dynamics of floating offshore wind turbines (FOWTs)",
    ],
  },
];

const msStudents = [
  {
    name: "Jaehoon Kim",
    interests: [
      "Floating body dynamics",
      "Control of Floating Offshore Wind Turbine",
      "Dynamics of Floating Vertical Axis Wind Turbine",
    ],
  },
];

const undergraduateStudents = [
  { name: "Jihan Kim", interests: ["Dynamics of FOWTs"] },
  { name: "Jaejoon Huh", interests: ["Dynamics of FOWTs"] },
  { name: "Sanggyeom Lee", interests: ["Fluid-Structure Interaction"] },
  { name: "Yong Hwi Kim", interests: ["Fluid-Structure Interaction"] },
  { name: "Chaeyoung Hong", interests: ["Aerodynamics of VAWT"] },
];

const pastMembers = [
  "Haeng Sik Ko, Ph.D. — Researcher, Korea Institute of Ocean Science & Technology",
  "Hyebin Lee, Ph.D. — Researcher, HD Hyundai Heavy Industries",
  "Sunny Kumar Poguluri, Ph.D. — Professor, Indian Institute of Technology Madras",
  "Dongeun Kim, Ph.D. — Researcher, Samsung Heavy Industries",
  "Dongmyung Im, M.S. — Researcher, Institute for Advanced Engineering",
];
---

<section class="students-section">
  <h2>Current Students</h2>

  <div class="student-group">
    <h3>Ph.D. Students</h3>
    <div class="student-grid">
      {phdStudents.map((student) => (
        <article class="student-card">
          <div class="avatar">{student.name.split(" ").map((n) => n[0]).join("")}</div>
          <h4>{student.name}</h4>
          <ul>
            {student.interests.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>

  <div class="student-group">
    <h3>M.S. Students</h3>
    <div class="student-grid">
      {msStudents.map((student) => (
        <article class="student-card">
          <div class="avatar">{student.name.split(" ").map((n) => n[0]).join("")}</div>
          <h4>{student.name}</h4>
          <ul>
            {student.interests.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>

  <div class="student-group">
    <h3>Undergraduate Students</h3>
    <div class="student-grid">
      {undergraduateStudents.map((student) => (
        <article class="student-card compact">
          <div class="avatar">{student.name.split(" ").map((n) => n[0]).join("")}</div>
          <h4>{student.name}</h4>
          <ul>
            {student.interests.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>

  <div class="student-group">
    <h3>Past Members</h3>
    <ul class="past-list">
      {pastMembers.map((member) => <li>{member}</li>)}
    </ul>
  </div>
</section>

<style>
  .students-section {
    margin-top: 90px;
  }

  .students-section h2 {
    font-size: clamp(34px, 4vw, 52px);
    letter-spacing: -0.04em;
    margin: 0 0 42px;
  }

  .student-group {
    margin-top: 56px;
  }

  .student-group h3 {
    font-size: 24px;
    margin: 0 0 24px;
  }

  .student-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .student-card {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    padding: 28px;
    min-height: 260px;
  }

  .student-card.compact {
    min-height: 210px;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(14,165,233,0.16), rgba(255,255,255,0.8));
    color: #0369a1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 20px;
  }

  .student-card h4 {
    font-size: 20px;
    margin: 0 0 14px;
  }

  .student-card ul,
  .past-list {
    margin: 0;
    padding-left: 18px;
    color: #475569;
    line-height: 1.8;
  }

  .student-card li,
  .past-list li {
    margin-bottom: 8px;
  }

  @media (max-width: 980px) {
    .student-grid {
      grid-template-columns: 1fr;
    }
  }
</style>