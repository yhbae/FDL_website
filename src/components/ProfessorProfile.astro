---

<section class="professor-card">

  <div class="photo-box">
    <!-- <img
      src="/images/people/yoon-hyeok-bae.jpg"
      alt="Yoon Hyeok Bae"
      class="professor-photo"
    /> -->
  </div>

  <div class="profile">

    <h2 class="professor-name">
      Yoon Hyeok Bae
    </h2>

    <div class="professor-role">
      Associate Professor<br />
      Department of Mechanical & System Design Engineering<br />
      Hongik University
    </div>

    <p class="description">
      Yoon Hyeok Bae is an Associate Professor at Hongik University. His research
      focuses on offshore floating systems, floater–mooring coupled dynamics,
      marine hydrodynamics, floating offshore wind turbines, digital twins,
      and intelligent offshore control systems.
    </p>

    <div class="info-grid">

      <div class="info-card">

        <h3>Education</h3>

        <ul>

          <li>
            Ph.D. Ocean Engineering
            <span class="institution">
              Texas A&amp;M University
            </span>
          </li>

          <li>
            M.S. Ocean Engineering
            <span class="institution">
              Texas A&amp;M University
            </span>
          </li>

          <li>
            B.S. Naval Architecture &amp; Ocean Engineering
            <span class="institution">
              Seoul National University
            </span>
          </li>

        </ul>

      </div>

      <div class="info-card">

        <h3>Professional Experience</h3>

        <ul>

          <li>
            Associate Professor
            <span class="institution">
              Hongik University
            </span>
          </li>

          <li>
            Assistant Professor
            <span class="institution">
              Jeju National University
            </span>
          </li>

          <li>
            Collaborative Researcher
            <span class="institution">
              National Renewable Energy Laboratory (NREL)
            </span>
          </li>

          <li>
            Postdoctoral Research Associate
            <span class="institution">
              Texas A&amp;M University
            </span>
          </li>

        </ul>

      </div>

    </div>

  </div>

</section>

<style>

.professor-card{

    display:grid;
    grid-template-columns:300px 1fr;
    gap:60px;

    padding:48px;

    background:rgba(255,255,255,.82);

    border:1px solid rgba(15,23,42,.08);

    border-radius:32px;

    backdrop-filter:blur(10px);

}

.photo-box{

    width:100%;
    max-width:300px;
    aspect-ratio:3 / 3.8;

    overflow:hidden;

    border-radius:24px;

    border:1px solid rgba(15,23,42,.08);

    background:#edf6fb;

}

.professor-photo{

    width:100%;
    height:100%;

    display:block;

    object-fit:cover;

    object-position:center top;

}

.profile{
    min-width:0;
}

.professor-name{

    margin:0 0 16px;

    font-size:56px;

    line-height:1;

    letter-spacing:-0.04em;

}

.professor-role{

    margin-bottom:28px;

    color:#0f766e;

    font-size:18px;

    font-weight:700;

    line-height:1.45;

}

.description{

    max-width:820px;

    margin-bottom:52px;

    color:#475569;

    font-size:18px;

    line-height:1.8;

}

.info-grid{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:64px;

    max-width:900px;

}

.info-card h3{

    margin:0 0 18px;

    font-size:24px;

    letter-spacing:-0.02em;

}

.info-card h3::after{

    content:"";

    display:block;

    width:48px;

    height:3px;

    margin-top:12px;

    background:#0f766e;

    border-radius:2px;

}

.info-card ul{

    margin:0;

    padding-left:20px;

    color:#475569;

}

.info-card li{

    margin-bottom:22px;

    line-height:1.7;

    font-size:17px;

}

.institution{

    display:block;

    margin-top:4px;

    color:#64748b;

    font-size:0.95em;

}

/* Tablet */

@media (max-width:980px){

    .professor-card{

        grid-template-columns:1fr;

        gap:36px;

        padding:36px;

    }

    .photo-box{

        width:100%;
        max-width:300px;

        margin:0 auto;

    }

    .profile{

        text-align:left;

    }

    .professor-name{

        font-size:42px;

    }

    .info-grid{

        grid-template-columns:1fr;

        gap:40px;

    }

}

/* Mobile */

@media (max-width:600px){

    .professor-card{

        padding:24px;

        border-radius:24px;

    }

    .photo-box{

        width:100%;
        max-width:240px;

        margin:0 auto;

    }

    .professor-name{

        font-size:34px;

    }

    .professor-role{

        font-size:16px;

    }

    .description{

        font-size:16px;

    }

    .info-card h3{

        font-size:21px;

    }

    .info-card li{

        font-size:16px;

    }

}

</style>