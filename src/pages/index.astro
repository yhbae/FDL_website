---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NewsPreview from "../components/NewsPreview.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Floater Dynamics Laboratory</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main>
      <section id="home" class="hero">
        <div class="hero-content">
          <p class="eyebrow">FLOATER DYNAMICS LABORATORY</p>

          <h1>Dynamics and Control of Offshore Floating Systems</h1>

          <p class="hero-subtitle">
            Dynamics, control, and digital engineering for offshore floating
            systems in complex ocean environments.
          </p>

          <div class="hero-buttons">
            <a href="/research" class="primary-button">Research</a>
            <a href="/publications" class="secondary-button">Publications</a>
          </div>
        </div>
      </section>

      <section id="about" class="section">
        <div class="section-inner">
          <p class="section-label">ABOUT</p>

          <h2>Floater Dynamics Laboratory</h2>

          <p class="lead">
            FDL investigates the dynamics, control, and design of offshore
            floating systems.
          </p>

          <p>
            Our research focuses on coupled interactions among floating bodies,
            mooring systems, waves, wind, current, and control systems. We
            develop numerical models, simulation methods, and data-driven
            frameworks for offshore platforms, floating wind turbines, wave
            energy systems, and future marine structures.
          </p>
        </div>
      </section>

      <NewsPreview />
    </main>

    <Footer />

    <style>
      :root {
        --text: #1e293b;
        --muted: #64748b;
        --accent: #0369a1;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Inter", Arial, sans-serif;
        color: var(--text);
        background: white;
      }

      .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 0 8%;
        color: white;
        background:
          linear-gradient(
            90deg,
            rgba(15, 23, 42, 0.34) 0%,
            rgba(15, 23, 42, 0.16) 46%,
            rgba(15, 23, 42, 0.03) 100%
          ),
          url("/images/hero.png");
        background-size: cover;
        background-position: center;
      }

      .hero-content {
        max-width: 780px;
        padding-top: 110px;
      }

      .eyebrow {
        margin: 0 0 24px;
        color: #e0f2fe;
        font-weight: 800;
        letter-spacing: 0.22em;
        font-size: 14px;
        text-shadow: 0 2px 18px rgba(2, 6, 23, 0.28);
      }

      h1 {
        margin: 0;
        font-size: clamp(42px, 6vw, 76px);
        line-height: 1.05;
        letter-spacing: -0.045em;
        font-weight: 700;
        text-shadow: 0 4px 26px rgba(2, 6, 23, 0.32);
      }

      .hero-subtitle {
        margin-top: 28px;
        max-width: 680px;
        color: rgba(255, 255, 255, 0.95);
        font-size: clamp(18px, 2vw, 23px);
        line-height: 1.65;
        font-weight: 350;
        text-shadow: 0 3px 18px rgba(2, 6, 23, 0.32);
      }

      .hero-buttons {
        display: flex;
        gap: 16px;
        margin-top: 38px;
      }

      .primary-button,
      .secondary-button {
        display: inline-block;
        padding: 14px 22px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
      }

      .primary-button {
        background: #0369a1;
        color: white;
        box-shadow: 0 16px 32px rgba(3, 105, 161, 0.22);
      }

      .secondary-button {
        background: rgba(255, 255, 255, 0.9);
        color: #1e293b;
      }

      .section {
        padding: 84px 8%;
      }

      .section-inner {
        max-width: 1180px;
        margin: 0 auto;
      }

      .section-label {
        margin: 0 0 16px;
        color: var(--accent);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.18em;
      }

      h2 {
        margin: 0 0 24px;
        font-size: clamp(34px, 4vw, 52px);
        letter-spacing: -0.03em;
      }

      .lead {
        font-size: 24px;
        line-height: 1.6;
        color: #334155;
        max-width: 900px;
      }

      .section p {
        font-size: 18px;
        line-height: 1.8;
        color: #475569;
        max-width: 1040px;
      }

      @media (max-width: 700px) {
        .hero {
          padding: 130px 6% 70px;
          background-position: center;
        }

        .section {
          padding: 72px 6%;
        }
      }
    </style>
  </body>
</html>