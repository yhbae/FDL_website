---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { news } from "../data/news";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>News | Floater Dynamics Laboratory</title>

    <style>
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        background: #f4f7fb;
        color: #0f172a;
      }

      .page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 90px 28px 120px;
      }

      .label {
        color: #0f766e;
        font-size: 13px;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 18px;
      }

      h1 {
        font-size: clamp(52px, 9vw, 92px);
        line-height: 0.95;
        letter-spacing: -0.06em;
        margin: 0 0 28px;
      }

      .intro {
        max-width: 900px;
        color: #475569;
        font-size: 20px;
        line-height: 1.8;
        margin-bottom: 70px;
      }

      .news-table {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .news-card {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 28px;

        background: rgba(255,255,255,0.82);
        border: 1px solid rgba(15,23,42,0.08);
        border-radius: 28px;
        overflow: hidden;

        padding: 22px;
      }

      .news-image {
        width: 100%;
        height: 170px;
        object-fit: cover;
        border-radius: 18px;
        background: #e2e8f0;
      }

      .meta {
        display: flex;
        gap: 16px;
        margin-bottom: 12px;
      }

      .date {
        color: #0f766e;
        font-weight: 800;
      }

      .category {
        color: #64748b;
        font-weight: 700;
      }

      .title {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 12px;
      }

      .description {
        color: #475569;
        line-height: 1.8;
      }

      @media (max-width: 760px) {
        .news-card {
          grid-template-columns: 1fr;
        }

        .news-image {
          height: 220px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="page">
      <p class="label">NEWS</p>

      <h1>News</h1>

      <p class="intro">
        Updates from Floater Dynamics Laboratory, including publications,
        projects, conferences, awards, and lab activities.
      </p>

      <section class="news-table">
        {news.map((item) => (
          <article class="news-card">

            <img
              src={item.image}
              alt={item.title}
              class="news-image"
            />

            <div>
              <div class="meta">
                <span class="date">{item.date}</span>
                <span class="category">{item.category}</span>
              </div>

              <div class="title">{item.title}</div>

              <div class="description">
                {item.description}
              </div>
            </div>

          </article>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>