---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCards from "../components/ContactCards.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact | Floater Dynamics Laboratory</title>

    <style>
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        background:
          radial-gradient(circle at top left, rgba(14,165,233,0.08), transparent 30%),
          #f4f7fb;
        color: #0f172a;
      }

      .page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 90px 28px 120px;
      }

      .label {
        color: #0f766e;
        font-size: 13px;
        letter-spacing: 0.18em;
        font-weight: 700;
        margin-bottom: 18px;
      }

      h1 {
        font-size: clamp(52px, 9vw, 92px);
        line-height: 0.95;
        letter-spacing: -0.06em;
        margin: 0 0 28px;
      }

      .intro {
        max-width: 760px;
        color: #475569;
        font-size: 20px;
        line-height: 1.8;
      }

      .contact-cta {
        margin-top: 80px;
        padding: 46px;
        border-radius: 32px;
        background: #0f172a;
        color: white;
      }

      .contact-cta h2 {
        margin: 0 0 18px;
        font-size: clamp(34px, 5vw, 56px);
        letter-spacing: -0.05em;
      }

      .contact-cta p {
        color: #cbd5e1;
        line-height: 1.8;
        max-width: 720px;
      }

      .contact-cta a {
        display: inline-block;
        margin-top: 22px;
        color: white;
        font-weight: 700;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="page">
      <p class="label">CONTACT</p>

      <h1>
        Research Collaboration
        <br />
        & Contact
      </h1>

      <p class="intro">
        Floater Dynamics Laboratory welcomes academic and industrial collaboration
        in offshore floating systems, marine hydrodynamics, floater–mooring coupled
        dynamics, digital twins, and control of marine systems.
      </p>

      <ContactCards />

      <section class="contact-cta">
        <h2>Get in Touch</h2>

        <p>
          For research collaboration, graduate study inquiries, or project-related
          discussions, please contact Prof. Yoon Hyeok Bae.
        </p>

        <a href="mailto:yhbae@hongik.ac.kr">
          yhbae@hongik.ac.kr →
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>